# Ejemplo ficticio. pnpm db:start genera .env.local con claves locales reales.
# Mantén el mismo origen en aplicación, Auth y pruebas. No copies claves de producción.
# Vercel: configura las cuatro variables de aplicación en el panel, con APP_URL
# en el dominio HTTPS definitivo. Consulta docs/vercel.md; no importes este
# archivo completo, pues contiene variables exclusivas de la demostración local.
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Acepta clave publicable sb_publishable_... o anon legacy del mismo proyecto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. NEVER prefix privileged values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Fictitious local accounts only. Use a different secret for every pilot account.
DEMO_PASSWORD=EnglishAction!2026
E2E_BASE_URL=http://127.0.0.1:3000
MAILBOX_URL=http://127.0.0.1:54324
# Opcional para pruebas con Chrome ya instalado; sin definir se usa Chromium de Playwright.
# PLAYWRIGHT_CHANNEL=chrome
# Operación de migraciones remotas: SUPABASE_ACCESS_TOKEN y SUPABASE_DB_PASSWORD
# se suministran solo a la CLI por el gestor de secretos o la sesión segura.
# No rellenes aquí valores reales; supabase login conserva su sesión fuera del repo.
# Aceptación alojada: copiar solo las variables necesarias a .env.hosted-test.local
# (ignorado), con APP_URL y E2E_BASE_URL en http://127.0.0.1:3002.
# EIA_HOSTED_ADMIN_EMAIL=
# EIA_HOSTED_TEACHER_EMAIL=
# EIA_HOSTED_STUDENT_EMAIL=
# EIA_HOSTED_OUTSIDER_EMAIL=
# EIA_HOSTED_TEST_PASSWORD=
# La suite exige cuatro identidades de prueba @example.invalid, previamente
# aprovisionadas en el proyecto autorizado; no crea usuarios ni envía correos.
