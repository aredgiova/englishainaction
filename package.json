{
  "name": "english-in-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/database.test.ts tests/migration-upgrade.test.ts tests/bootstrap-admin.test.ts tests/adventure-access.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:adventure": "playwright test --config playwright.adventure.config.ts",
    "test:e2e:adventure:hosted": "playwright test --config playwright.adventure-hosted.config.ts",
    "test:e2e:auth-design": "playwright test --config playwright.auth-design.config.ts",
    "test:e2e:journey": "playwright test --config playwright.journey.config.ts",
    "test:e2e:hosted": "playwright test --config playwright.hosted.config.ts",
    "verify:local": "tsx --env-file=.env.local scripts/verify-local.ts",
    "verify:hosted": "node --env-file=.env.hosted-test.local scripts/verify-hosted-security.mjs",
    "openapi:validate": "tsx scripts/validate-openapi.ts",
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "demo:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "admin:bootstrap": "tsx --env-file=.env.local scripts/bootstrap-admin.ts",
    "check": "pnpm openapi:validate && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "supabase": "3.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
